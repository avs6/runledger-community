# Copy to apps/api/.env for local development outside Docker

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://runledger:runledger@localhost:5432/runledger

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ────────────────────────────────────────────────────────────────
# Used for session signing (NextAuth) — keep this secret in production
SECRET_KEY=dev-secret-key-change-in-production

# Admin secret for /admin/* endpoints (tenant/workspace management).
# Used as the X-Admin-Secret header value in the Settings UI.
# If ADMIN_SECRET is not set, SECRET_KEY is used as fallback.
ADMIN_SECRET=dev-admin-secret

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── SMTP (Brevo) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=noreply@yourdomain.com
SMTP_USER=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:3000

# ── Firebase Admin SDK (social login) ────────────────────────────────────────
# Leave empty to disable social login.
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
