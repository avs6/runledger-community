# Copy to .env.local for local development outside Docker
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production-32chars!!
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pre-fills the Admin Secret field in Settings > Tenant Management.
# Must match ADMIN_SECRET in apps/api/.env (or SECRET_KEY if ADMIN_SECRET is not set).
NEXT_PUBLIC_ADMIN_SECRET=dev-admin-secret
