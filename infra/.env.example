# ── RunLedger Community — Docker Compose Secrets ─────────────────────────────
# Copy this file to infra/.env (gitignored) and fill in real values.
# docker-compose reads infra/.env automatically when run from infra/.

# ── Infrastructure ────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-32chars
ADMIN_SECRET=runledger-admin

# ── OTel Collector ────────────────────────────────────────────────────────────
# API key used by the OTel Collector to authenticate to /v1/traces.
# Generate one via: POST /admin/bootstrap  or  POST /settings/api-keys
RUNLEDGER_API_KEY=

# ── SMTP (optional — leave empty to disable email notifications) ──────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=noreply@yourdomain.com
SMTP_USER=
SMTP_PASSWORD=

# App URL used in email links (change to your public domain in production)
APP_BASE_URL=http://localhost:3000
