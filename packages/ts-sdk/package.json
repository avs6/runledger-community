{
  "name": "@runledger/sdk",
  "version": "0.6.0",
  "description": "RunLedger SDK for TypeScript/Node.js \u2014 instrument OpenAI and Vercel AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avs6/runledger-community.git",
    "directory": "packages/ts-sdk"
  },
  "homepage": "https://github.com/avs6/runledger-community/tree/master/packages/ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/avs6/runledger-community/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "runledger",
    "llm",
    "observability",
    "finops",
    "openai",
    "anthropic"
  ],
  "license": "MIT",
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "openai": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
