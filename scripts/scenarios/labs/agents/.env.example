# RunLedger lab agents — environment.
# Copy this to `.env` (in this same folder) and fill in your workspace key:
#     cp .env.example .env

# ── RunLedger ──────────────────────────────────────────────────────────────────
# The workspace API key you minted in the dashboard (Settings → API Keys).
# Every key is scoped to ONE workspace/team — swap the key to switch teams:
#   • AI Support Team  key → Labs 01, 04, 05
#   • AI Development Team key → Lab 02
#   • AI Test Team key → Lab 03
RUNLEDGER_API_KEY=rl_...

# Local Docker stack maps the API to host port 8201.
RUNLEDGER_BASE_URL=http://localhost:8201

# ── Ollama ─────────────────────────────────────────────────────────────────────
# A model you've pulled:  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
