# RunLedger Samples — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── RunLedger ──────────────────────────────────────────────────────────────────

# Your workspace API key (required for all examples)
RUNLEDGER_API_KEY=rl_test_...

# Base URL of the RunLedger API server
# Use http://localhost:8000 for the local Docker stack
# Use https://api.runledger.io for the hosted service (when available)
RUNLEDGER_BASE_URL=http://localhost:8000

# Set to "true" to run in local/offline mode (prints JSON to stdout instead of
# sending events to the API). Useful for debugging the SDK without a running server.
# Set to "false" (default) to send events to RUNLEDGER_BASE_URL.
RUNLEDGER_LOCAL=false

# ── OpenAI ─────────────────────────────────────────────────────────────────────

# Required for examples 01–05 and 08
OPENAI_API_KEY=sk-...

# ── Ollama (local LLM) ─────────────────────────────────────────────────────────

# Required for example 06
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Slack (optional) ───────────────────────────────────────────────────────────

# Required for example 13 (Slack alert test). Leave blank to skip that step.
# Create an Incoming Webhook in your Slack workspace:
#   https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── Admin (optional) ───────────────────────────────────────────────────────────

# Only needed if you want to call admin endpoints directly.
# Must match the ADMIN_SECRET set on the RunLedger API server
# (falls back to SECRET_KEY if ADMIN_SECRET is not configured on the server).
RUNLEDGER_ADMIN_SECRET=runledger-admin
