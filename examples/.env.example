# RunLedger Samples — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── RunLedger ──────────────────────────────────────────────────────────────────

# Workspace API key (required for all examples).
#
# Every API key is scoped to exactly one workspace. All runs, sessions, budgets,
# and analytics queries are automatically filtered to the workspace the key
# belongs to — you never have to pass a workspace_id explicitly.
#
# To get your key:
#   1. Start the stack: docker compose up
#   2. Open http://localhost:3000 and log in
#   3. Go to Settings → API Keys → New API Key
#   4. Copy the generated key (shown only once) and paste it here.
#
# Switching workspaces = swap this key. Each workspace has its own key set.
RUNLEDGER_API_KEY=rl_test_...

# Dashboard session key (required for org-admin control-plane examples such as
# organization profile, members, workspaces, and org notification settings).
# Create it by logging into the dashboard and reusing the active authenticated session key.
RUNLEDGER_SESSION_KEY=rl_session_...

# Base URL of the RunLedger API server
# Use http://localhost:8000 for the local Docker stack
# Use https://api.runledger.io for the hosted service (when available)
RUNLEDGER_BASE_URL=http://localhost:8000

# Set to "true" to run in local/offline mode (prints JSON to stdout instead of
# sending events to the API). Useful for debugging the SDK without a running server.
# Set to "false" (default) to send events to RUNLEDGER_BASE_URL.
RUNLEDGER_LOCAL=false

# ── OpenAI ─────────────────────────────────────────────────────────────────────

# Required for examples 01–05 and 08
OPENAI_API_KEY=sk-...

# ── Ollama (local LLM) ─────────────────────────────────────────────────────────

# Required for example 06
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ── Slack (optional) ───────────────────────────────────────────────────────────

# Required for example 13 (Slack alert test). Leave blank to skip that step.
# Create an Incoming Webhook in your Slack workspace:
#   https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── Admin (optional) ───────────────────────────────────────────────────────────

# Only needed if you want to call admin endpoints directly.
# Must match the ADMIN_SECRET set on the RunLedger API server
# (falls back to SECRET_KEY if ADMIN_SECRET is not configured on the server).
RUNLEDGER_ADMIN_SECRET=runledger-admin
