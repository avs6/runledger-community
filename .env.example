# RunLedger — environment variables
# Copy to .env and fill in values before running docker compose up

# ── Required ──────────────────────────────────────────────────────────────────

# 32+ character random string — used for JWT signing and NextAuth session encryption
SECRET_KEY=change-me-to-a-random-32char-string

# Admin bootstrap secret — used with POST /admin/bootstrap on first run
ADMIN_SECRET=runledger-admin

# ── License (enterprise features) ────────────────────────────────────────────
# Leave RUNLEDGER_MODE=oss for community edition (no license required)
# Set RUNLEDGER_MODE=oss and supply a RUNLEDGER_LICENSE_KEY for enterprise features:
#   SSO / OIDC, SCIM, Warehouse export, Audit log, BYOK, and more
#
# Contact sales@runledger.io to obtain a license key.
# Or generate one locally (vendor signing key required):
#   RUNLEDGER_LICENSE_SIGNING_KEY=<key> python -m runledger_api.core.license_cli issue \
#     --org "My Org" --edition enterprise --features all --seats 0

RUNLEDGER_MODE=oss
RUNLEDGER_LICENSE_KEY=
RUNLEDGER_LICENSE_SIGNING_KEY=

# ── Ports (change if you have conflicts) ─────────────────────────────────────

API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── URLs (update for production deployments) ──────────────────────────────────

RUNLEDGER_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── After first bootstrap — fill in from POST /admin/bootstrap response ───────
# Used by the OTel Collector, seed script, SDK examples, and Postman collection.

RUNLEDGER_API_KEY=

# ── Provider API keys (optional — for live gateway completions) ───────────────
# Set these to enable live traffic through the Model Gateway.
# Without them the gateway routes are still created; just no live completions.
# The seed script picks these up automatically via OPENAI_API_KEY / ANTHROPIC_API_KEY.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Optional: transactional email via Brevo ──────────────────────────────────

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# ── Optional: Firebase social login ──────────────────────────────────────────

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Optional: Stripe payments ─────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# ── Optional: GitHub-backed prompt storage ────────────────────────────────────

GITHUB_TOKEN=
GITHUB_PROMPTS_REPO=

# ── Optional: PostgreSQL password override ────────────────────────────────────
# Default is "runledger" — fine for local use, change for production

POSTGRES_PASSWORD=runledger
