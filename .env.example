# RunLedger — environment variables
# Copy to .env and fill in values before running docker compose up

# ── Required ──────────────────────────────────────────────────────────────────

# 32+ character random string — used for JWT signing and NextAuth session encryption
SECRET_KEY=change-me-to-a-random-32char-string

# Admin bootstrap secret — used with POST /admin/bootstrap on first run
ADMIN_SECRET=runledger-admin

# ── License (enterprise features) ────────────────────────────────────────────
# Leave RUNLEDGER_MODE=oss for community edition (no license required)
# Set RUNLEDGER_MODE=oss and supply a RUNLEDGER_LICENSE_KEY for enterprise features:
#   SSO / OIDC, SCIM, Warehouse export, Audit log, BYOK, and more
#
# Contact sales@runledger.io to obtain a license key.
# Or generate one locally (vendor signing key required):
#   RUNLEDGER_LICENSE_SIGNING_KEY=<key> python -m runledger_api.core.license_cli issue \
#     --org "My Org" --edition enterprise --features all --seats 0

RUNLEDGER_MODE=oss
RUNLEDGER_LICENSE_KEY=
RUNLEDGER_LICENSE_SIGNING_KEY=

# ── Ports (change if you have conflicts) ─────────────────────────────────────
# RunLedger uses a namespaced range (3201-3299 / 8201-8299) to avoid clashing
# with other local products. Postgres/Redis/OTLP stay on their standard ports.

API_PORT=8201
WEB_PORT=3201
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── URLs (update for production deployments) ──────────────────────────────────
# RUNLEDGER_BASE_URL is the API's in-container loopback (container port 8000) — leave as-is.

RUNLEDGER_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3201
NEXTAUTH_URL=http://localhost:3201
CORS_ORIGINS=http://localhost:3201

# ── After first bootstrap — fill in from POST /admin/bootstrap response ───────
# Used by the OTel Collector, seed script, SDK examples, and Postman collection.

RUNLEDGER_API_KEY=

# ── Provider API keys (optional — for live gateway completions) ───────────────
# Set these to enable live traffic through the Model Gateway.
# Without them the gateway routes are still created; just no live completions.
# The seed script picks these up automatically via OPENAI_API_KEY / ANTHROPIC_API_KEY.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Optional: transactional email via Brevo ──────────────────────────────────

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# ── Optional: Firebase social login ──────────────────────────────────────────

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Optional: Stripe payments ─────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# ── Optional: GitHub-backed prompt storage ────────────────────────────────────

GITHUB_TOKEN=
GITHUB_PROMPTS_REPO=

# ── Optional: PostgreSQL password override ────────────────────────────────────
# Default is "runledger" — fine for local use, change for production

POSTGRES_PASSWORD=runledger

# ── Optimization layer (Phase 1) ──────────────────────────────────────────────
# Shared services stood up by infra/docker-compose.optimization.yml.

# Dedicated vector store (Qdrant)
QDRANT_URL=http://runledger-qdrant:6333

# Shared embedding model of record (fastembed / ONNX, CPU)
EMBEDDING_SVC_URL=http://runledger-embedding-svc:8100
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Semantic cache (PDF gap #1)
SEMANTIC_CACHE_SVC_URL=http://runledger-semantic-cache-svc:8101
SEMANTIC_CACHE_THRESHOLD=0.95

# Local LLM runtimes — EXTERNAL, self-hosted (NOT part of the compose suite).
# Both are OpenAI-compatible and routable as gateway providers ("ollama" | "vllm" | "local").
# From inside a container the Docker host is http://host.docker.internal:<port>.
#   - Ollama on this machine:  http://host.docker.internal:11434/v1
#   - Remote vLLM server:      http://<vllm-host>:8000/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
VLLM_BASE_URL=
# Model used for optimizer worker roles (compaction / compression / consolidation)
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=llama3.2:3b

# ── Optimization flywheel (Phase 7) ───────────────────────────────────────────
# Offline analyzer that learns the cheapest optimization config per traffic segment
# that still holds the workspace quality SLA, then recommends (or auto-applies) it.
FLYWHEEL_SVC_URL=http://runledger-flywheel:8109
FLYWHEEL_PORT=8215
